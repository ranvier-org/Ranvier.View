<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../fable/Ranvier.View.Anime.Browser/Ranvier.View.Anime.Browser.fsproj" />
    <Compile Include="Example.fs" />
  </ItemGroup>
    <ItemGroup Condition="'$(UseLocalRanvierCss)' == 'true'">
        <ProjectReference Include="$(RanvierCssRoot)/src/Ranvier.Css.Bindings/Ranvier.Css.Bindings.fsproj" />
    </ItemGroup>
    <ItemGroup Condition="'$(UseLocalRanvierCss)' != 'true'">
        <PackageReference Include="Ranvier.Css.Bindings" Version="$(RanvierCssAddonsVersion)" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Ranvier.Css.View" Version="$(RanvierCssAddonsVersion)" />
    </ItemGroup>
</Project>
