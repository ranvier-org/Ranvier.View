<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RanvierWebCoreProject>$(MSBuildThisFileDirectory)../../src/Ranvier.View.WebCore/Ranvier.View.WebCore.fsproj</RanvierWebCoreProject>
    <NativeRuntimePackageVersion Condition="'$(NativeRuntimePackageVersion)' == ''">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(RanvierWebCoreProject)')), '&lt;RanvierWebCoreNativeVersion[^&gt;]*&gt;([^&lt;]+)&lt;').Groups[1].Value)</NativeRuntimePackageVersion>
    <UsePublishedGpu Condition="'$(UsePublishedGpu)' == ''">false</UsePublishedGpu>
    <RestoreConfigFile>$(MSBuildThisFileDirectory)NuGet.Config</RestoreConfigFile>
    <DefineConstants Condition="'$(RanvierPackageSuffix)' == '.Traced'">$(DefineConstants);RANVIER_TRACE</DefineConstants>
  </PropertyGroup>
</Project>
