<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SnapshotBaselineVersion>0.1.0-rc.5</SnapshotBaselineVersion>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
    <ProjectReference Include="../../src/Ranvier.View.WebCore/Ranvier.View.WebCore.fsproj" Condition="'$(BaselineManaged)' != 'true'" />
    <PackageReference Include="Ranvier.View.WebCore" Version="$(SnapshotBaselineVersion)" Condition="'$(BaselineManaged)' == 'true'" />
  </ItemGroup>
</Project>
