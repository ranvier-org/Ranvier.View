<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Tables.fs" />
    <Compile Include="ViewTables.fs" />
    <Compile Include="ViewHyperlinks.fs" />
    <Compile Include="Reflection.fs" />
    <Compile Include="Hyperlinks.fs" />
    <Compile Include="Namespaces.fs" />
    <Compile Include="ElementOperations.fs" />
    <Compile Include="Stylesheets.fs" />
    <Compile Include="RuleMutations.fs" />
    <Compile Include="CssEscaping.fs" />
    <Compile Include="CssSupport.fs" />
    <Compile Include="ComputedStyles.fs" />
    <Compile Include="CustomProperties.fs" />
    <Compile Include="StyleValues.fs" />
    <Compile Include="StyleMaps.fs" />
    <Compile Include="GeometryValues.fs" />
    <Compile Include="MatrixValues.fs" />
    <Compile Include="TransformValues.fs" />
    <Compile Include="SvgGeometry.fs" />
    <Compile Include="SvgValues.fs" />
    <Compile Include="SvgLifecycle.fs" />
    <Compile Include="SvgShapes.fs" />
    <Compile Include="SvgText.fs" />
    <Compile Include="SvgViewSelection.fs" />
    <Compile Include="SvgAnimations.fs" />
    <Compile Include="SvgDocumentLifecycle.fs" />
    <Compile Include="TransformLifecycle.fs" />
    <Compile Include="MatrixLifecycle.fs" />
    <Compile Include="GeometryLifecycle.fs" />
    <Compile Include="StyleMapLifecycle.fs" />
    <Compile Include="StyleValueLifecycle.fs" />
    <Compile Include="CustomPropertyLifecycle.fs" />
    <Compile Include="TypedStyles.fs" />
    <Compile Include="FragmentRectangles.fs" />
    <Compile Include="FontTransitionRules.fs" />
    <Compile Include="PositionTry.fs" />
    <Compile Include="CounterStyleRules.fs" />
    <Compile Include="KeyframeRules.fs" />
    <Compile Include="ConditionalRules.fs" />
    <Compile Include="CascadeRules.fs" />
    <Compile Include="SheetConstruction.fs" />
    <Compile Include="SheetElements.fs" />
    <Compile Include="LocalePreferences.fs" />
    <Compile Include="LocaleLifecycle.fs" />
    <Compile Include="UserTiming.fs" />
    <Compile Include="../UserTiming/Native.fs" Link="UserTimingNative.fs" />
    <Compile Include="Native.fs" />
    <ProjectReference Include="../../src/Ranvier.View.WebCore/Ranvier.View.WebCore.fsproj" />
    <None Include="Assets/Ahem.ttf" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Ranvier.Css.Dom$(RanvierPackageSuffix)" Version="0.1.0-alpha.1" />
    <PackageReference Include="Ranvier.Css.Bindings$(RanvierPackageSuffix)" Version="0.1.1-alpha.1" />
  </ItemGroup>
</Project>
