<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>AccessibilityAot</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../AccessibilityAot/Program.fs" Link="Program.fs" />
    <PackageReference Include="Ranvier.View.WebCore.Sdl$(CohortSuffix)" Version="$(CohortBackendVersion)" />
    <PackageReference Include="Ranvier.WebCore.Accessibility.Atspi" Version="$(CohortProviderVersion)" Condition="'$(CohortLinux)' == 'true'" />
    <PackageReference Update="FSharp.Core" Version="10.1.401" />
  </ItemGroup>
</Project>
