<Project Sdk="Microsoft.NET.Sdk">

    <!--
    The Ranvier.View.Anime parts: compiled with Fable over anime.js and run under the Node test runner with jsdom and a
    mocked clock (npm test), and run on .NET over Ranvier.Anime as the server-render check (dotnet run). The jsdom checks
    and bundle entries use the anime.js bindings, so they compile under Fable only.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Fixtures.fs" />
        <Compile Include="SizeEntries.fs" Condition="'$(FABLE_COMPILER)' == 'true'" />
        <Compile Include="MotionChecks.fs" Condition="'$(FABLE_COMPILER)' == 'true'" />
        <Compile Include="ServerChecks.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Ranvier.View.Dom\Ranvier.View.Dom.fsproj" />
        <!-- Each engine's package project: the native one on .NET, the anime.js one under Fable. -->
        <ProjectReference Include="..\..\src\Ranvier.View.Anime\Ranvier.View.Anime.fsproj" Condition="'$(FABLE_COMPILER)' != 'true'" />
        <ProjectReference Include="..\..\src\Fable.Ranvier.View.Anime\Fable.Ranvier.View.Anime.fsproj" Condition="'$(FABLE_COMPILER)' == 'true'" />
        <PackageReference Update="FSharp.Core" Version="10.1.401" />
    </ItemGroup>

</Project>
