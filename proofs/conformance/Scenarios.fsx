// Generates theories/Conformance/Expected.v by running 10 deterministic conformance scenarios
// directly against the real Ranvier.View / Dom / Twin / WebCore / Sdl assemblies.
#load "Harness.fsx"

open System
open System.IO
open System.Text
open Harness
open Ranvier.View.Dom.Scheduling

let private coqBool (b: bool) =
    if b then "true" else "false"

let private coqNatList (xs: seq<int>) =
    "["
    + String.Join ("; ", xs |> Seq.map string)
    + "]"

let private parseKeyValues (obs: string) : Map<string, string> =
    obs.Split ';'
    |> Array.choose (fun part ->
        let eq = part.IndexOf '='

        if eq < 0 then
            None
        else
            Some (part.Substring (0, eq), part.Substring (eq + 1)))
    |> Map.ofArray

// Wait: `fmtInts` uses `;` inside `[...]`, so split top-level `;` outside `[...]`!
let private parseFields (obs: string) : Map<string, string> =
    let items = ResizeArray<string>()
    let mutable depth = 0
    let mutable start = 0

    for i = 0 to obs.Length - 1 do
        match obs[i] with
        | '[' -> depth <- depth + 1
        | ']' -> depth <- depth - 1
        | ';' when depth = 0 ->
            items.Add (obs.Substring (start, i - start))
            start <- i + 1
        | _ -> ()

    items.Add (obs.Substring start)

    items
    |> Seq.map (fun kv ->
        let eq = kv.IndexOf '='
        kv.Substring (0, eq), kv.Substring (eq + 1))
    |> Map.ofSeq

let private parseBracketInts (s: string) : int list =
    let inner = s.TrimStart('[').TrimEnd(']')

    if String.IsNullOrWhiteSpace inner then
        []
    else
        inner.Split ';' |> Array.map int |> Array.toList

let emitExpected (outPath: string) =
    let sb = StringBuilder ()

    let line (s: string) =
        sb.AppendLine (s) |> ignore

    line "(* Generated by proofs/conformance/Scenarios.fsx from real F# runs; do not edit by hand. *)"
    line "From Stdlib Require Import List ZArith."
    line "From RanvierView.Pure Require Import Layout Hydration Lifetime Scheduling."
    line "From RanvierView Require Import Extract."
    line "Import ListNotations."
    line ""

    // S01: Layout + Departures held exit + LIS reorder + finish exit
    let s01 =
        runLayoutFSharp [ 11; 12; 13; 14 ] [ LRegExit 12; LReconcile [ 14; 11; 13 ]; LFinExit 12 ]
        |> parseFields

    line (
        sprintf
            "Definition exp_S01 : layout_view :=\n  {| lv_dom := %s; lv_live := %s; lv_open := %s; lv_before := %s; lv_after := %s |}."
            (coqNatList (parseBracketInts s01["dom"]))
            (coqNatList (parseBracketInts s01["live"]))
            s01["open"]
            s01["before"]
            s01["after"]
    )

    line ""

    // S02: Layout clear blocked by held exit + Reflow latest-post gate
    let s02 =
        runLayoutFSharp [ 21; 22 ] [ LRegExit 21; LReconcile []; LRfBefore; LRfBefore; LRfPost 0; LRfPost 1 ]
        |> parseFields

    line (
        sprintf
            "Definition exp_S02 : layout_view :=\n  {| lv_dom := %s; lv_live := %s; lv_open := %s; lv_before := %s; lv_after := %s |}."
            (coqNatList (parseBracketInts s02["dom"]))
            (coqNatList (parseBracketInts s02["live"]))
            s02["open"]
            s02["before"]
            s02["after"]
    )

    line ""

    // S03: SSR nested bracket logicalNext
    let s03Raw =
        runSsrFSharp (SsrReg (1, [ SsrNode 10; SsrReg (2, [ SsrNode 20; SsrReg (3, []) ]); SsrNode 30 ])) [ 99 ]

    let s03Toks =
        s03Raw.TrimStart('[').TrimEnd(']').Split(';', StringSplitOptions.RemoveEmptyEntries)
        |> Array.map (fun t ->
            if t = "E" then "TokEnd"
            elif t.StartsWith "S" then "TokStart " + t.Substring 1
            else "TokNode " + t.Substring 1)
        |> String.concat "; "

    line (sprintf "Definition exp_S03 : option (list ssr_token) := Some [%s]." s03Toks)
    line ""

    // S04: HydrationCursor nested LIFO rollback
    let s04 =
        runCursorFSharp 100 false [ HOpAdd 10; HOpScope [ HOpAdd 5; HOpAdd -3 ]; HOpAdd 20 ]
        |> parseFields

    line (sprintf "Definition exp_S04 : Z * Z * nat := (%s%%Z, %s%%Z, %s)." s04["mid"] s04["after"] s04["held"])

    line ""

    // S05: HydrationCursor commit clears held
    let s05 =
        runCursorFSharp 50 true [ HOpAdd 7; HOpScope [ HOpAdd 3 ] ]
        |> parseFields

    line (sprintf "Definition exp_S05 : Z * Z * nat := (%s%%Z, %s%%Z, %s)." s05["mid"] s05["after"] s05["held"])

    line ""

    // S06: ViewBoundary + BindingState lifecycle & stale retry fencing
    let s06 =
        runBoundaryFSharp
            true
            [
                BExpect
                BExpect
                BEndSetup
                BStep (0, BPending)
                BStep (0, BVal)
                BStep (1, BVal)
                BReveal
                BStep (0, BErr)
                BRetry 0
                BRetry 1
            ]
        |> parseFields

    line (
        sprintf
            "Definition exp_S06 : boundary_model :=\n  {| bm_tracks := true; bm_waiting := %s; bm_setting_up := %s; bm_revealed := %s; bm_failed := %s; bm_pending_sig := %s; bm_wakes := %s; bm_clear_calls := %s; bm_fail_calls := %s; bm_gen := %s |}."
            s06["wait"]
            s06["setup"]
            s06["rev"]
            s06["fail"]
            s06["pend"]
            s06["wakes"]
            s06["clear"]
            s06["fails"]
            s06["gen"]
    )

    line ""

    // S07: Placement out-of-order group sort + own-before-forwarded
    let s07 =
        runPlacementFSharp false [ PEnter; PAdd 101; PEnter; PAdd 201; PLeave; PAdd 102; PRelChild 901; PPlace ]
        |> parseFields

    line (
        sprintf
            "Definition exp_S07 : pl_view :=\n  {| pv_held := %s; pv_executed := %s; pv_to_parent := %s |}."
            s07["held"]
            (coqNatList (parseBracketInts s07["exec"]))
            (coqNatList (parseBracketInts s07["parent"]))
    )

    line ""

    // S08: MountLifetime attached-DOM cleanup order
    let s08Raw =
        runLifetimeFSharp (LtNode (1, [ 10; 11 ], [ LtNode (2, [ 20 ], [ LtNode (3, [ 30 ], []) ]) ]))

    let s08Evs =
        s08Raw.TrimStart('[').TrimEnd(']').Split(';', StringSplitOptions.RemoveEmptyEntries)
        |> Array.map (fun item ->
            if item.StartsWith "C(" then
                let parts = item.Substring(2, item.Length - 3).Split ','
                sprintf "EvOwnerCleanup %s %s" parts[0] parts[1]
            else
                let id = item.Substring (2, item.Length - 3)
                sprintf "EvDomRelease %s" id)
        |> String.concat "; "

    line (sprintf "Definition exp_S08 : list lt_event := [%s]." s08Evs)
    line ""

    // S09: Scheduling.Queue coalescing + FailFastCancel + Dropped + Scope grouping + stale ticket
    let s09 =
        runQueueFSharp
            [
                QRes (1, false)
                QRes (2, true)
                QRes (1, true)
                QEnq (0, 10)
                QEnq (0, 11)
                QEnq (1, 20)
                QEnq (2, 30)
                QFlu (FailFastCancel, [ 11 ])
                QTik (0, CollectAndContinue, [])
            ]
        |> parseFields

    let repInner = s09["rep"].TrimStart('[').TrimEnd(']')

    let coqRep =
        if String.IsNullOrWhiteSpace repInner then
            "[]"
        else
            let pairs =
                repInner.Split ','
                |> Array.map (fun p ->
                    let kv = p.Split ':'
                    sprintf "(%s, %s)" kv[0] (coqNatList (parseBracketInts kv[1])))
                |> String.concat "; "

            "[" + pairs + "]"

    line (
        sprintf
            "Definition exp_S09 : q_view :=\n  {| qv_committed := %s; qv_dropped := %s; qv_reported := %s; qv_pending_len := %s; qv_disposed := %s |}."
            (coqNatList (parseBracketInts s09["comm"]))
            (coqNatList (parseBracketInts s09["drop"]))
            coqRep
            s09["pend"]
            s09["disp"]
    )

    line ""

    // S10: OwnerWorkQueue wakeup + capacity + Stop & CompletionFence GPU failure
    let s10Owq =
        runOwqFSharp [ OWake true; OEnq (1, 2); OEnq (2, 2); OEnq (3, 2); ODeq; OStop ]
        |> parseFields

    let s10Cf =
        runFenceFSharp [ CTry PNotReady; CReset; CTry PGpuFail; CReset; CTry PReady ]
        |> parseFields

    let cfOuts =
        s10Cf["outs"].TrimStart('[').TrimEnd(']').Split(';', StringSplitOptions.RemoveEmptyEntries)
        |> Array.map (function
            | "ok1" -> "FenceOk true"
            | "ok0" -> "FenceOk false"
            | _ -> "FenceError")
        |> String.concat "; "

    line (
        sprintf
            "Definition exp_S10 : owq_view * (list fence_outcome * list nat * bool) :=\n  ({| ov_dequeued_items := %s; ov_count := %s; ov_wakes := %s; ov_rejected := %s; ov_discarded := %s; ov_stopped := %s |},\n   ([%s], %s, %s))."
            (coqNatList (parseBracketInts s10Owq["deq"]))
            s10Owq["cnt"]
            s10Owq["wakes"]
            s10Owq["rej"]
            s10Owq["disc"]
            s10Owq["stop"]
            cfOuts
            (coqNatList (parseBracketInts s10Cf["rel"]))
            s10Cf["fail"]
    )

    line ""

    // S11: Reflow post cancellation recovery (Issue #174)
    let s11 =
        runLayoutFSharp [ 31; 32 ] [ LRfBefore; LRfCancel 0; LRfBefore; LRfPost 1 ]
        |> parseFields

    line (
        sprintf
            "Definition exp_S11 : layout_view :=\n  {| lv_dom := %s; lv_live := %s; lv_open := %s; lv_before := %s; lv_after := %s |}."
            (coqNatList (parseBracketInts s11["dom"]))
            (coqNatList (parseBracketInts s11["live"]))
            s11["open"]
            s11["before"]
            s11["after"]
    )

    line ""

    // S12: FailFastCancel in-flush slot replacement triggers Dropped (Issue #175)
    let s12 =
        runQueueFSharp
            [
                QRes (1, false)
                QRes (2, true)
                QRes (2, true)
                QEnq (0, 10)
                QEnq (1, 20)
                QFluReenq (FailFastCancel, [ 10 ], [ (10, 1, 30); (10, 2, 40) ])
                QFlu (FailFastCancel, [])
            ]
        |> parseFields

    let rep12Inner = s12["rep"].TrimStart('[').TrimEnd(']')

    let coqRep12 =
        if String.IsNullOrWhiteSpace rep12Inner then
            "[]"
        else
            let pairs =
                rep12Inner.Split ','
                |> Array.map (fun p ->
                    let kv = p.Split ':'
                    sprintf "(%s, %s)" kv[0] (coqNatList (parseBracketInts kv[1])))
                |> String.concat "; "

            "[" + pairs + "]"

    line (
        sprintf
            "Definition exp_S12 : q_view :=\n  {| qv_committed := %s; qv_dropped := %s; qv_reported := %s; qv_pending_len := %s; qv_disposed := %s |}."
            (coqNatList (parseBracketInts s12["comm"]))
            (coqNatList (parseBracketInts s12["drop"]))
            coqRep12
            s12["pend"]
            s12["disp"]
    )

    let text = sb.ToString().Replace("\r\n", "\n")
    File.WriteAllText (outPath, text, UTF8Encoding false)

let argv = fsi.CommandLineArgs[1..]

let target =
    if argv.Length >= 1 then
        argv[0]
    else
        Path.Combine (__SOURCE_DIRECTORY__, "..", "theories", "Conformance", "Expected.v")

emitExpected target
