<Project Sdk="Microsoft.NET.Sdk">
  <!--
  Experiment: a compiler driver MSBuild runs in place of fsc.dll (DotnetFscCompilerPath). It compiles with the fickle FCS
  and embeds a stamp per top-level declaration as AssemblyMetadata. See docs/research/native-hmr.md for the results.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RollForward>Major</RollForward>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Ranvier.View.WebCore.Hmr/Stamps.fs" Link="Stamps.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Ranvier.FSharp.Checker" Version="0.1.0-preview.3" />
  </ItemGroup>
</Project>
