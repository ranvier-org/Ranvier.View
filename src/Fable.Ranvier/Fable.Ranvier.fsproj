<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Global.fs" />
        <Compile Include="Types\DomQueue.Microtask.fs" />
        <Compile Include="Types\DomScheduling.fs" />
        <Compile Include="Dom.fs"/>
        <Compile Include="Mount.fs"/>
    </ItemGroup>

    <ItemGroup Condition="'$(FABLE_COMPILER)' == 'true'">
      <PackageReference Include="Xantham.Fable.Core" Version="0.2.0" />
      <PackageReference Include="Xantham.Fable.Core.TS" Version="0.2.1" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="Fable.Core" Version="5.3.0" />
      <PackageReference Update="FSharp.Core" Version="10.1.401" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalRanvier)' == 'true'">
        <ProjectReference Include="$(RanvierRoot)/src/Ranvier/Ranvier.fsproj" />
    </ItemGroup>
    <ItemGroup Condition="'$(FABLE_COMPILER)' != 'true'">
        <ProjectReference Include="../Ranvier.View.Dom/Ranvier.View.Dom.fsproj" />
    </ItemGroup>
    <ItemGroup Condition="'$(UseLocalRanvier)' == 'true' and '$(FABLE_COMPILER)' == 'true'">
        <ProjectReference Include="$(RanvierRoot)/src/Fable.Ranvier.Dom/Fable.Ranvier.Dom.fsproj" />
    </ItemGroup>
    <ItemGroup Condition="'$(UseLocalRanvier)' != 'true' and '$(FABLE_COMPILER)' == 'true'">
        <PackageReference Include="Fable.Ranvier.Dom$(RanvierPackageSuffix)" Version="$(RanvierDomVersion)" />
    </ItemGroup>
    <ItemGroup Condition="'$(UseLocalRanvier)' != 'true'">
        <PackageReference Include="Ranvier$(RanvierPackageSuffix)" Version="$(RanvierVersion)" />
    </ItemGroup>
</Project>
