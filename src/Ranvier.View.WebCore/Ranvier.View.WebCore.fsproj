<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Library</OutputType>
        <RootNamespace>Ranvier.View.WebCore</RootNamespace>
        <AssemblyName>Ranvier.View.WebCore</AssemblyName>
        <PackageId>Ranvier.View.WebCore</PackageId>
        <PackageId Condition="'$(RanvierTrace)' == 'true'">Ranvier.View.WebCore.Traced</PackageId>
        <Title>Ranvier.View.WebCore</Title>
        <Description>Runs Ranvier's view and shared DOM API on .NET against a native WebCore page: the app forwards window input and paints the page into its window.</Description>
        <Description Condition="'$(RanvierTrace)' == 'true'">The traced build of Ranvier.View.WebCore: Ranvier's view on a native WebCore page. Depends on Ranvier.View.Dom.Traced.</Description>
        <PackageTags>reactive;signals;view;dom;webcore;native;fsharp</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>Experimental. The API may change.</PackageReleaseNotes>
        <Version>0.1.0-alpha.33</Version>
        <IsAotCompatible>true</IsAotCompatible>
        <IsPackable>true</IsPackable>
        <!-- Generated wrapper implementation members inherit their contracts' documentation. -->
        <NoWarn>$(NoWarn);FS3390</NoWarn>
    </PropertyGroup>

    <!-- RanvierWebCoreNativeDir holds runtimes/<rid>/native for local native runtime checks. -->
    <PropertyGroup>
        <RanvierWebCoreNativeVersion Condition="'$(RanvierWebCoreNativeVersion)' == ''">0.1.0-preview.40</RanvierWebCoreNativeVersion>
        <UseLocalRanvierWebCore Condition="'$(UseLocalRanvierWebCore)' == ''">false</UseLocalRanvierWebCore>
        <RanvierWebCoreRoot Condition="'$(RanvierWebCoreRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../Ranvier.WebCore'))</RanvierWebCoreRoot>
        <RanvierWebCoreNativeRid Condition="'$(RanvierWebCoreNativeRid)' == '' and '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</RanvierWebCoreNativeRid>
        <RanvierWebCoreNativeRid Condition="'$(RanvierWebCoreNativeRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</RanvierWebCoreNativeRid>
    </PropertyGroup>

    <ItemGroup Condition="'$(RanvierWebCoreNativeDir)' == ''">
        <PackageReference Include="Ranvier.WebCore.Native" Version="$(RanvierWebCoreNativeVersion)" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalRanvierWebCore)' != 'true'">
        <PackageReference Include="Ranvier.WebCore" Version="$(RanvierWebCoreNativeVersion)" />
    </ItemGroup>
    <ItemGroup Condition="'$(UseLocalRanvierWebCore)' == 'true'">
        <ProjectReference Include="$(RanvierWebCoreRoot)/src/Ranvier.WebCore/Ranvier.WebCore.fsproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(RanvierWebCoreNativeDir)' != ''">
        <None Include="$(RanvierWebCoreNativeDir)/runtimes/$(RanvierWebCoreNativeRid)/native/**/*"
              Link="%(RecursiveDir)%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest"
              Pack="false"
              Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Objects.fs" />
        <Compile Include="Events.fs" />
        <Compile Include="Traversal.fs" />
        <Compile Include="Marshalling.fs" />
        <Compile Include="Generated/Objects.fs" />
        <Compile Include="EventTargets.fs" />
        <Compile Include="Host.fs" />
        <Compile Include="SvgViews.fs" />
        <Compile Include="StyleSheets.fs" />
        <Compile Include="CssQueries.fs" />
        <Compile Include="CustomProperties.fs" />
        <Compile Include="StyleValues.fs" />
        <Compile Include="StyleMaps.fs" />
        <Compile Include="Geometry.fs" />
        <Compile Include="TransformValues.fs" />
        <Compile Include="ComputedStyles.fs" />
        <Compile Include="Locales.fs" />
        <Compile Include="Timing.fs" />
        <Compile Include="Capabilities.fs" />
        <Compile Include="Cancellation.fs" />
        <Compile Include="Resources.fs" />
        <Compile Include="EventConstruction.fs" />
        <Compile Include="InputState.fs" />
        <Compile Include="FormData.fs" />
        <Compile Include="FormSubmissions.fs" />
        <Compile Include="ToggleEvents.fs" />
        <Compile Include="EventDetails.fs" />
        <Compile Include="BinaryValues.fs" />
        <Compile Include="Urls.fs" />
        <Compile Include="TextSegmentation.fs" />
        <Compile Include="Crypto.fs" />
        <Compile Include="Screen.fs" />
        <Compile Include="Highlights.fs" />
        <Compile Include="Viewport.fs" />
        <Compile Include="ViewportScroll.fs" />
        <Compile Include="VisualViewport.fs" />
        <Compile Include="Frames.fs" />
        <None Include="Generated/report.txt" />
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="../../brand/icon/ranvier-icon.png" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Ranvier.View.Dom/Ranvier.View.Dom.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Canonical managed WebCore interop uses FSharp.Core 10.1.401. -->
        <PackageReference Update="FSharp.Core" Version="10.1.401" />
    </ItemGroup>

    <ItemGroup Condition="'$(RanvierTrace)' == 'true'">
        <AssemblyMetadata Include="RanvierTrace" Value="true" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Ranvier.View.WebCore.Tests" />
    </ItemGroup>

</Project>
