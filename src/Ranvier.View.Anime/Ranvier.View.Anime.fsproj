<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Ranvier.Anime targets net10.0 only. -->
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Library</OutputType>
        <RootNamespace>Ranvier.View.Anime</RootNamespace>
        <AssemblyName>Ranvier.View.Anime</AssemblyName>
        <PackageId>Ranvier.View.Anime</PackageId>
        <!-- The traced build packs as Ranvier.View.Anime.Traced and depends on the traced view and anime packages. -->
        <PackageId Condition="'$(RanvierTrace)' == 'true'">Ranvier.View.Anime.Traced</PackageId>
        <Title>Ranvier.View.Anime</Title>
        <Description>Motion parts for Ranvier.View templates over the native Ranvier.Anime, for .NET hosts: lifecycle, enter and exit, FLIP and signal-driven animation, omitted by the server renderer. Fable projects use Fable.Ranvier.View.Anime.</Description>
        <Description Condition="'$(RanvierTrace)' == 'true'">The traced build of Ranvier.View.Anime: motion parts for Ranvier.View templates over the native Ranvier.Anime. Depends on the traced view and anime packages.</Description>
        <PackageTags>reactive;signals;view;animation;native;fsharp</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>Alpha release. The API may change before 1.0.</PackageReleaseNotes>
        <!-- Set by ShipIt from CHANGELOG.md. -->
        <Version>0.1.46-rc.2</Version>
        <AssemblyVersion>0.0.0.0</AssemblyVersion>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../Fable.Ranvier.View.Anime/Motion.fs" Link="Motion.fs" />
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="../../brand/icon/ranvier-icon.png" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Ranvier.View/Ranvier.View.fsproj" />
    </ItemGroup>

    <!-- The native engine. The same Motion.fs over anime.js is Fable.Ranvier.View.Anime, which a Fable project references. -->
    <ItemGroup Condition="'$(UseLocalRanvierAnime)' == 'true'">
        <ProjectReference Include="$(RanvierAnimeRoot)/src/Ranvier.Anime/Ranvier.Anime.fsproj" />
    </ItemGroup>
    <ItemGroup Condition="'$(UseLocalRanvierAnime)' != 'true'">
        <PackageReference Include="Ranvier.Anime$(RanvierPackageSuffix)" Version="$(RanvierNativeAnimeVersion)" />
    </ItemGroup>

    <ItemGroup>
        <!-- A .NET package: Fable projects reference Fable.Ranvier.View.Anime, so this one ships no Fable sources. -->
        <PackageReference Remove="Fable.Package.SDK" />
        <!-- Ranvier.Anime requires FSharp.Core 10.0.100. -->
        <PackageReference Update="FSharp.Core" Version="10.0.100" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Ranvier.View.Anime.Tests" />
    </ItemGroup>

    <ItemGroup Condition="'$(RanvierTrace)' == 'true'">
        <AssemblyMetadata Include="RanvierTrace" Value="true" />
    </ItemGroup>

</Project>
