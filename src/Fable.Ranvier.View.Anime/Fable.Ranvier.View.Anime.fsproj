<Project Sdk="Microsoft.NET.Sdk">

    <!--
    The motion parts over Fable.Ranvier.Anime (anime.js): the package a Fable project references. Its assembly is what
    Fable type checks a consumer against, so it is compiled over the anime.js bindings, where Ranvier.View.Anime compiles
    the same Motion.fs over the native Ranvier.Anime. On .NET the bindings are inert stubs, which is what the server
    side of an isomorphic project needs. Motion.fs is here because a Fable package ships its own sources.
    -->
    <PropertyGroup>
        <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
        <OutputType>Library</OutputType>
        <RootNamespace>Ranvier.View.Anime</RootNamespace>
        <AssemblyName>Fable.Ranvier.View.Anime</AssemblyName>
        <PackageId>Fable.Ranvier.View.Anime</PackageId>
        <!-- The traced build packs as Fable.Ranvier.View.Anime.Traced and depends on the traced view and anime packages. -->
        <PackageId Condition="'$(RanvierTrace)' == 'true'">Fable.Ranvier.View.Anime.Traced</PackageId>
        <Title>Fable.Ranvier.View.Anime</Title>
        <Description>Motion parts for Ranvier.View templates over anime.js, for Fable: lifecycle, enter and exit, FLIP and signal-driven animation, omitted by the server renderer. .NET hosts use Ranvier.View.Anime.</Description>
        <Description Condition="'$(RanvierTrace)' == 'true'">The traced build of Fable.Ranvier.View.Anime: motion parts for Ranvier.View templates over anime.js. Depends on Ranvier.View.Traced and Fable.Ranvier.Anime.Traced.</Description>
        <PackageTags>reactive;signals;view;animation;animejs;fable;fsharp</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>Alpha release. The API may change before 1.0.</PackageReleaseNotes>
        <!-- Set by ShipIt from ../Ranvier.View.Anime/CHANGELOG.md. -->
        <Version>0.1.46-rc.1</Version>
        <AssemblyVersion>0.0.0.0</AssemblyVersion>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Motion.fs" />
        <None Include="../Ranvier.View.Anime/README.md" Pack="true" PackagePath="\" Visible="false" />
        <None Include="../../brand/icon/ranvier-icon.png" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Ranvier.View/Ranvier.View.fsproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalRanvierAnime)' == 'true'">
        <ProjectReference Include="$(RanvierAnimeRoot)/src/Fable.Ranvier.Anime/Fable.Ranvier.Anime.fsproj" />
    </ItemGroup>
    <ItemGroup Condition="'$(UseLocalRanvierAnime)' != 'true'">
        <PackageReference Include="Fable.Ranvier.Anime$(RanvierPackageSuffix)" Version="$(RanvierAnimeVersion)" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Ranvier.View.Anime.Tests" />
    </ItemGroup>

    <ItemGroup Condition="'$(RanvierTrace)' == 'true'">
        <AssemblyMetadata Include="RanvierTrace" Value="true" />
    </ItemGroup>

</Project>
