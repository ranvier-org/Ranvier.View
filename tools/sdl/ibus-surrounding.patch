+static bool IBus_SendSurrounding(void)
+{
+    SDL_DBusContext *dbus = SDL_DBus_GetContext();
+    DBusMessage *message;
+    DBusMessageIter args, variant, object, dictionary, attributes, attr_object, attr_dictionary, attr_array;
+    const char *text_name = "IBusText", *attribute_name = "IBusAttrList";
+    bool ok;
+
+    if (!ranvier_surrounding || !input_ctx_path || !IBus_CheckConnection(dbus)) {
+        return false;
+    }
+    message = dbus->message_new_method_call(ibus_service, input_ctx_path, ibus_input_interface, "SetSurroundingText");
+    if (!message) {
+        return false;
+    }
+    dbus->message_iter_init_append(message, &args);
+    ok = dbus->message_iter_open_container(&args, DBUS_TYPE_VARIANT, "(sa{sv}sv)", &variant)
+        && dbus->message_iter_open_container(&variant, DBUS_TYPE_STRUCT, NULL, &object)
+        && dbus->message_iter_append_basic(&object, DBUS_TYPE_STRING, &text_name)
+        && dbus->message_iter_open_container(&object, DBUS_TYPE_ARRAY, "{sv}", &dictionary)
+        && dbus->message_iter_close_container(&object, &dictionary)
+        && dbus->message_iter_append_basic(&object, DBUS_TYPE_STRING, &ranvier_surrounding)
+        && dbus->message_iter_open_container(&object, DBUS_TYPE_VARIANT, "(sa{sv}av)", &attributes)
+        && dbus->message_iter_open_container(&attributes, DBUS_TYPE_STRUCT, NULL, &attr_object)
+        && dbus->message_iter_append_basic(&attr_object, DBUS_TYPE_STRING, &attribute_name)
+        && dbus->message_iter_open_container(&attr_object, DBUS_TYPE_ARRAY, "{sv}", &attr_dictionary)
+        && dbus->message_iter_close_container(&attr_object, &attr_dictionary)
+        && dbus->message_iter_open_container(&attr_object, DBUS_TYPE_ARRAY, "v", &attr_array)
+        && dbus->message_iter_close_container(&attr_object, &attr_array)
+        && dbus->message_iter_close_container(&attributes, &attr_object)
+        && dbus->message_iter_close_container(&object, &attributes)
+        && dbus->message_iter_close_container(&variant, &object)
+        && dbus->message_iter_close_container(&args, &variant)
+        && dbus->message_iter_append_basic(&args, DBUS_TYPE_UINT32, &ranvier_cursor)
+        && dbus->message_iter_append_basic(&args, DBUS_TYPE_UINT32, &ranvier_anchor)
+        && dbus->connection_send(ibus_conn, message, NULL);
+    if (ok) {
+        dbus->connection_flush(ibus_conn);
+    }
+    dbus->message_unref(message);
+    return ok;
+}
