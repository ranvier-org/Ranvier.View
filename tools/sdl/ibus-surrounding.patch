 static Uint32 IBus_ModState(void)
 {
     Uint32 ibus_mods = 0;
@@ -221,6 +227,11 @@ static DBusHandlerResult IBus_MessageHandler(DBusConnection *conn, DBusMessage *
 {
     SDL_DBusContext *dbus = (SDL_DBusContext *)user_data;
 
+    if (dbus->message_is_signal(msg, ibus_input_interface, "RequireSurroundingText")) {
+        IBus_SendSurrounding();
+        return DBUS_HANDLER_RESULT_HANDLED;
+    }
+
     if (dbus->message_is_signal(msg, ibus_input_interface, "CommitText")) {
         DBusMessageIter iter;
         const char *text;
@@ -410,6 +421,9 @@ static void SDLCALL IBus_SetCapabilities(void *data, const char *name, const cha
 
     if (IBus_CheckConnection(dbus)) {
         Uint32 caps = IBUS_CAP_FOCUS;
+        if (ranvier_surrounding) {
+            caps |= IBUS_CAP_SURROUNDING_TEXT;
