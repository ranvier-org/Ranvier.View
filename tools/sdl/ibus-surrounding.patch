+__attribute__((visibility("default"))) Uint32 SDLCALL SDL_Ranvier_GetIbusDeleteEventType(void)
+{
+    if (!ranvier_delete_event && sizeof(void *) >= sizeof(Uint64)) {
+        ranvier_delete_event = SDL_RegisterEvents(1);
+    }
+    return ranvier_delete_event;
+}
+
+__attribute__((visibility("default"))) bool SDLCALL SDL_Ranvier_SetIbusSurrounding(SDL_Window *window, const char *text, Uint32 cursor, Uint32 anchor, Uint64 token)
+{
+    SDL_DBusContext *dbus = SDL_DBus_GetContext();
+    char *copy = NULL;
+    bool capability_changed;
+
+    if (!window || window != SDL_GetKeyboardFocus() || !input_ctx_path || !IBus_CheckConnection(dbus)) {
+        return false;
+    }
+    if (text && (!token || !ranvier_delete_event || !ranvier_sender)) {
+        return false;
+    }
+    ranvier_token = text ? token : 0;
+    ranvier_delete_blocked = false;
+    if (text && ranvier_surrounding && !SDL_strcmp(text, ranvier_surrounding)
+        && cursor == ranvier_cursor && anchor == ranvier_anchor) {
+        return ranvier_last_send_ok || (ranvier_last_send_ok = IBus_SendSurrounding());
+    }
+    capability_changed = !!text != !!ranvier_surrounding;
+    if (text) {
+        copy = SDL_strdup(text);
+        if (!copy) {
+            return false;
+        }
+    }
+    SDL_free(ranvier_surrounding);
+    ranvier_surrounding = copy;
+    ranvier_cursor = cursor;
+    ranvier_anchor = anchor;
+    if (capability_changed) {
+        IBus_SetCapabilities(NULL, NULL, NULL, SDL_GetHint(SDL_HINT_IME_IMPLEMENTED_UI));
+    }
+    ranvier_last_send_ok = !text || IBus_SendSurrounding();
+    return ranvier_last_send_ok;
+}
