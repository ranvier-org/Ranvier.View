 static char *ibus_addr_file = NULL;
 static int inotify_fd = -1, inotify_wd = -1;
 
+/* Ranvier extension: SDL remains the sole owner of this IBus context. */
+static char *ranvier_surrounding;
+static Uint32 ranvier_cursor, ranvier_anchor;
+static bool ranvier_last_send_ok;
+static bool IBus_SendSurrounding(void);
